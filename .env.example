# Copy to .env and fill in. All values are optional for local development.

# Public domain used when building QR/join links (host:port or full domain)
REPLIT_DEV_DOMAIN=localhost:5000

# Port the backend listens on when run as `python main.py`
PORT=5000

# CORS: comma-separated allowed origins, or "*" for any (default "*").
# Set to your real frontend origin(s) in production, e.g.
# ALLOWED_ORIGINS=https://jukebob.example.com
ALLOWED_ORIGINS=*

# Admin dashboard credentials (override the insecure development default!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_SESSION_TTL_HOURS=24

# Optional production integrations
SUPABASE_URL=
SUPABASE_KEY=
STRIPE_SECRET_KEY=
